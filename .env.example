# ==============================================================================
# Конфигурация RAG-ассистента ООО «ХАЙТЕК МЕДИА»
# Скопируйте этот файл в .env и подставьте свои ключи
# ==============================================================================

# Ключ Gemini / OpenAI API
OPENAI_API_KEY=your_openai_or_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Ключи GigaChat API (Сбер)
GIGACHAT_RQUID=your_gigachat_rquid_here
GIGACHAT_AUTH_KEY=your_gigachat_auth_key_here

# Параметры RAG и векторной базы ChromaDB
TOP_K=3
CHUNK_SIZE=450
CHUNK_OVERLAP=90
